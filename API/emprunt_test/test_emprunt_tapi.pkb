CREATE OR REPLACE PACKAGE BODY test_emprunt_tapi IS

   -- generated by utPLSQL for SQL Developer on 2026-11-08 16:34:28

   g_reponse_obj VARCHAR2(4000);
   g_mode_test CHAR(1) := 'O';


   --
   -- test retourner
   --
   PROCEDURE retourner IS
      l_id_emprunt emprunt.idemprunt%TYPE;
      l_id_ret emprunt.idemprunt%TYPE;
   BEGIN
      -- arrange
      SELECT MIN(idemprunt)
      INTO l_id_emprunt
      FROM emprunt;

      -- act
      g_reponse_obj := emprunt_tapi.retourner(l_id_emprunt);

      l_id_ret := JSON_VALUE(g_reponse_obj, '$.data[0].id');

      DBMS_OUTPUT.PUT_LINE('g_reponse_obj: ' || g_reponse_obj);

      -- assert
      ut.expect(l_id_ret).to_equal(l_id_emprunt);

   END retourner;


   --
   -- test retourner_inexistant
   --
   PROCEDURE retourner_inexistant IS
      l_status_code VARCHAR2(20);
   BEGIN
      -- arrange

      -- act
      g_reponse_obj := emprunt_tapi.retourner(-1);

      l_status_code := JSON_VALUE(
         g_reponse_obj, '$.errors[0].code'
      );

      DBMS_OUTPUT.PUT_LINE('g_reponse_obj: ' || g_reponse_obj);

      -- assert
      ut.expect(l_status_code).to_equal('-20002');

   END retourner_inexistant;


   --
   -- test supprimer
   --
   PROCEDURE supprimer IS
      l_id_emprunt emprunt.idemprunt%TYPE;
      l_id_ret emprunt.idemprunt%TYPE;
      l_nombre NUMBER;
   BEGIN
      -- arrange
      SELECT MIN(idemprunt)
      INTO l_id_emprunt
      FROM emprunt;

      -- act
      g_reponse_obj := emprunt_tapi.supprimer(
         l_id_emprunt, g_mode_test
      );

      l_id_ret := JSON_VALUE(g_reponse_obj, '$.data.id');

      SELECT COUNT(*)
      INTO l_nombre
      FROM emprunt
      WHERE idemprunt = l_id_emprunt;

      DBMS_OUTPUT.PUT_LINE('g_reponse_obj: ' || g_reponse_obj);

      -- assert
      ut.expect(l_id_ret).to_equal(l_id_emprunt);
      ut.expect(l_nombre).to_equal(0);

      ut.expect(
         JSON_VALUE(g_reponse_obj, '$.data.type')
      ).to_equal('emprunt');

      ROLLBACK;

   EXCEPTION
      WHEN OTHERS THEN
         ROLLBACK;
         RAISE;
   END supprimer;


   --
   -- test supprimer_inexistant
   --
   PROCEDURE supprimer_inexistant IS
      l_status_code VARCHAR2(20);
   BEGIN
      -- arrange

      -- act
      g_reponse_obj := emprunt_tapi.supprimer(-1, g_mode_test);

      l_status_code := JSON_VALUE(
         g_reponse_obj, '$.errors[0].code'
      );

      DBMS_OUTPUT.PUT_LINE('g_reponse_obj: ' || g_reponse_obj);

      -- assert
      ut.expect(l_status_code).to_equal('-2');

   END supprimer_inexistant;


   --
   -- test ajouter
   --
   PROCEDURE ajouter IS
      l_id_membre membre.idmembre%TYPE;
      l_id_livre livre.idlivre%TYPE;
      l_id_utilisateur utilisateur.idutilisateur%TYPE;
      l_id_emprunt emprunt.idemprunt%TYPE;
      l_nombre NUMBER;
   BEGIN
      -- arrange
      SELECT MIN(idmembre)
      INTO l_id_membre
      FROM membre;

      SELECT MIN(idlivre)
      INTO l_id_livre
      FROM livre;

      SELECT MIN(idutilisateur)
      INTO l_id_utilisateur
      FROM utilisateur;

      -- act
      g_reponse_obj := emprunt_tapi.ajouter(
         l_id_membre,
         l_id_livre,
         l_id_utilisateur,
         SYSDATE,
         SYSDATE + 14,
         g_mode_test
      );

      l_id_emprunt := JSON_VALUE(g_reponse_obj, '$.id');

      SELECT COUNT(*)
      INTO l_nombre
      FROM emprunt
      WHERE idemprunt = l_id_emprunt;

      DBMS_OUTPUT.PUT_LINE('g_reponse_obj: ' || g_reponse_obj);

      -- assert
      ut.expect(l_id_emprunt).to_be_greater_or_equal(1);
      ut.expect(l_nombre).to_equal(1);

      ROLLBACK;

   EXCEPTION
      WHEN OTHERS THEN
         ROLLBACK;
         RAISE;
   END ajouter;


   --
   -- test ajouter_null
   --
   PROCEDURE ajouter_null IS
      l_status_code VARCHAR2(20);
   BEGIN
      -- arrange

      -- act
      g_reponse_obj := emprunt_tapi.ajouter(
         NULL,
         NULL,
         NULL,
         NULL,
         NULL,
         g_mode_test
      );

      l_status_code := JSON_VALUE(
         g_reponse_obj, '$.errors[0].code'
      );

      DBMS_OUTPUT.PUT_LINE('g_reponse_obj: ' || g_reponse_obj);

      -- assert
      ut.expect(l_status_code).to_equal('-18');

   END ajouter_null;


   --
   -- test modifier
   --
   PROCEDURE modifier IS
      l_id_emprunt emprunt.idemprunt%TYPE;
      l_id_ret emprunt.idemprunt%TYPE;
      l_date_retour emprunt.dateretourprevue%TYPE;
   BEGIN
      -- arrange
      SELECT MIN(idemprunt)
      INTO l_id_emprunt
      FROM emprunt;

      -- act
      g_reponse_obj := emprunt_tapi.modifier(
         p_id_emprunt => l_id_emprunt,
         p_nouv_dateretourprevue => DATE '2030-01-10',
         p_test => g_mode_test
      );

      l_id_ret := JSON_VALUE(g_reponse_obj, '$.data.id');

      SELECT dateretourprevue
      INTO l_date_retour
      FROM emprunt
      WHERE idemprunt = l_id_emprunt;

      DBMS_OUTPUT.PUT_LINE('g_reponse_obj: ' || g_reponse_obj);

      -- assert
      ut.expect(l_id_ret).to_equal(l_id_emprunt);

      ut.expect(
         TO_CHAR(l_date_retour, 'YYYY-MM-DD')
      ).to_equal('2030-01-10');

      ROLLBACK;

   EXCEPTION
      WHEN OTHERS THEN
         ROLLBACK;
         RAISE;
   END modifier;


   --
   -- test modifier_inexistant
   --
   PROCEDURE modifier_inexistant IS
      l_status_code VARCHAR2(20);
   BEGIN
      -- arrange

      -- act
      g_reponse_obj := emprunt_tapi.modifier(
         p_id_emprunt => -1,
         p_nouv_enretard => 1,
         p_test => g_mode_test
      );

      l_status_code := JSON_VALUE(
         g_reponse_obj, '$.errors[0].code'
      );

      DBMS_OUTPUT.PUT_LINE('g_reponse_obj: ' || g_reponse_obj);

      -- assert
      ut.expect(l_status_code).to_equal('-116');

   END modifier_inexistant;

END test_emprunt_tapi;
/
SHOW ERRORS;